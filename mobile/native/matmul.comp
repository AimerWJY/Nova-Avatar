#version 450
// Deliberately simple FP32 tiled kernel; not an optimized ML inference runtime.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer Weight { float w[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { float c[]; };
layout(push_constant) uniform Shape { uint m; uint n; uint k; uint activation; } shape;
shared float tile_a[16][16];
shared float tile_w[16][16];
void main() {
    uint x = gl_LocalInvocationID.x;
    uint y = gl_LocalInvocationID.y;
    uint row = gl_WorkGroupID.y * 16 + y;
    uint col = gl_WorkGroupID.x * 16 + x;
    float sum = 0.0;
    for (uint base = 0; base < shape.k; base += 16) {
        tile_a[y][x] = row < shape.m && base + x < shape.k ? a[row * shape.k + base + x] : 0.0;
        tile_w[y][x] = col < shape.n && base + y < shape.k ? w[col * shape.k + base + y] : 0.0;
        barrier();
        for (uint j = 0; j < 16; ++j) sum += tile_a[y][j] * tile_w[j][x];
        barrier();
    }
    if (row < shape.m && col < shape.n) {
        if (shape.activation == 1) sum = max(sum, 0.0);
        if (shape.activation == 2)
            sum = 0.5 * sum * (1.0 + tanh(0.7978845608 * (sum + 0.044715 * sum * sum * sum)));
        c[row * shape.n + col] = sum;
    }
}
